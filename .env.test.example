# Public disposable credentials for infra/compose.test.yml only.
# Root db:migrate:test, test:integration and test:e2e:db explicitly load .env.test.
# Direct API/CI commands still require TEST_DATABASE_URL in the process environment.
TEST_DATABASE_URL=postgresql://specbridge_test:local_test_only@127.0.0.1:5434/specbridge_test
NODE_ENV=test
