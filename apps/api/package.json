{
  "name": "specbridge-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node --experimental-strip-types scripts/migrate.mjs --development",
    "db:migrate:test": "node --experimental-strip-types scripts/migrate.mjs --test",
    "db:migrate:verify": "node --experimental-strip-types scripts/migrate.mjs --verify-development",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "test:e2e:auth": "pnpm run build && vitest run --config ./vitest.config.auth-e2e.ts",
    "test:e2e:rbac": "pnpm run build && vitest run --config ./vitest.config.rbac-e2e.ts",
    "test:e2e:requirements": "pnpm run build && vitest run --config ./vitest.config.requirements-e2e.ts",
    "test:e2e:changes": "pnpm run build && vitest run --config ./vitest.config.changes-e2e.ts",
    "test:e2e:deliveries": "pnpm run build && vitest run --config ./vitest.config.deliveries-e2e.ts",
    "test:e2e:reads": "vitest run --config ./vitest.config.reads-e2e.ts",
    "openapi:generate": "pnpm run build && node scripts/openapi.mjs",
    "openapi:check": "pnpm run build && node scripts/openapi.mjs --check"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.5",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "openai": "^7.47.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "drizzle-kit": "^0.31.11",
    "openapi-typescript": "7.10.1",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
