# Copy to .env and choose a local development password; never commit real credentials.
POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql://specbridge:replace_me@127.0.0.1:5433/specbridge
# The test container uses public, disposable credentials. Tests do not load .env.
# Explicitly export this URL before running test:integration or db:migrate:test.
TEST_DATABASE_URL=postgresql://specbridge_test:local_test_only@127.0.0.1:5434/specbridge_test
# Same-origin JSON writes require Origin plus X-CSRF-Protection: 1.
# Production must set exact HTTPS origins; no trailing slash or wildcard.
AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Development Next rewrite only; production must set actual trusted proxy IPs/CIDRs.
# Leave empty when exposing the API directly. Never use true or a universal CIDR.
# Auth rate limits always use the API socket peer, not forwarded IP headers.
# Users behind one Next proxy share the IP quota; this setting cannot change that.
AUTH_TRUSTED_PROXIES=loopback
